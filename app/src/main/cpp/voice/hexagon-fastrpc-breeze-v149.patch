 typedef bool (*hexagon_op_validator_t)(ggml_backend_hexagon_context * ctx, const ggml_tensor * op);
+// Breeze-specific validators used by the FastRPC/mempool transport.
+// These keep the large vocoder channel broadcasts, sine, and transpose-conv
+// entirely on HTP without asking the generic binary VTCM staging path to hold
+// waveform-sized rows.
+static bool breeze_is_channel_binary(const ggml_tensor * op) {
+    if (!op || (op->op != GGML_OP_ADD && op->op != GGML_OP_MUL)) return false;
+    const ggml_tensor * src0 = op->src[0];
+    const ggml_tensor * src1 = op->src[1];
+    if (!src0 || !src1 ||
+        src0->type != GGML_TYPE_F32 || src1->type != GGML_TYPE_F32 ||
+        op->type != GGML_TYPE_F32) return false;
+    if (src0->ne[2] != 1 || src0->ne[3] != 1 ||
+        op->ne[0] != src0->ne[0] || op->ne[1] != src0->ne[1] ||
+        op->ne[2] != 1 || op->ne[3] != 1) return false;
+    if (src1->ne[0] != 1 || src1->ne[1] != src0->ne[1] ||
+        src1->ne[2] != 1 || src1->ne[3] != 1) return false;
+    return src0->nb[0] == sizeof(float) &&
+           src1->nb[0] == sizeof(float) &&
+           op->nb[0] == sizeof(float) &&
+           src0->nb[1] == src0->ne[0] * sizeof(float) &&
+           src1->nb[1] == sizeof(float) &&
+           op->nb[1] == op->ne[0] * sizeof(float);
+}
+
+static bool breeze_validate_sin(ggml_backend_hexagon_context * ctx, const ggml_tensor * op) {
+    GGML_UNUSED(ctx);
+    const ggml_tensor * src = op ? op->src[0] : nullptr;
+    return src && src->type == GGML_TYPE_F32 && op->type == GGML_TYPE_F32 &&
+           ggml_are_same_shape(src, op) &&
+           ggml_is_contiguous(src) && ggml_is_contiguous(op);
+}
+
+static bool breeze_validate_col2im(ggml_backend_hexagon_context * ctx, const ggml_tensor * op) {
+    GGML_UNUSED(ctx);
+    const ggml_tensor * src = op ? op->src[0] : nullptr;
+    if (!src || src->type != GGML_TYPE_F32 || op->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(src) || !ggml_is_contiguous(op)) return false;
+    const int32_t * p = (const int32_t *) op->op_params;
+    const int32_t stride = p[0];
+    const int32_t oc = p[1];
+    const int32_t padding = p[2];
+    if (stride <= 0 || oc <= 0 || src->ne[0] % oc != 0) return false;
+    const int64_t kernel = src->ne[0] / oc;
+    const int64_t t_out = (src->ne[1] - 1) * stride + kernel - 2 * padding;
+    return t_out > 0 && op->ne[0] == t_out && op->ne[1] == oc &&
+           op->ne[2] == 1 && op->ne[3] == 1;
+}
