diff --git a/src/backbone.cpp b/src/backbone.cpp
--- a/src/backbone.cpp
+++ b/src/backbone.cpp
@@ -22,12 +22,30 @@
 
-static ggml_tensor * build_audio_embed(ggml_context * ctx, BreezeModel & m, ggml_tensor * idx, int n) {
