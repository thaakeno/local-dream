+static int ggmlhexagon_init_rpcmempool(ggml_backend_hexagon_context * ctx) {
+    if (nullptr == ctx) {
+        GGMLHEXAGON_LOG_ERROR("sanity check failure");
+        return 1;
+    }
+
+    const int htp_arch = ggmlhexagon_probe_dspinfo(ctx);
+    if (0 == htp_arch) {
+        GGMLHEXAGON_LOG_ERROR("failed to get valid htp arch");
+        return 2;
+    }
+
+    // A successful AP-side rpcmem_alloc2() does not mean the whole allocation
+    // fits in the DSP process virtual-address window. On current Android HTP
+    // firmware the DSP mapping is usually the tighter limit (~3.5 GiB per PD).
+    // Probe the complete AP -> FastRPC -> DSP registration transaction and
+    // keep the largest pool the active HTP session can actually map.
+    const size_t max_target_mb = htp_arch > 75 ? 4032 : 3830;
+    const size_t min_target_mb = 2048;
+    const size_t step_mb       = 128;
+    const enum fastrpc_map_flags mmap_flags =
+        g_hexagon_appcfg.rpc_mmap_mode == 1 ? FASTRPC_MAP_FD : FASTRPC_MAP_FD_DELAYED;
+    const char * mmap_mode_str = g_hexagon_appcfg.rpc_mmap_mode == 1 ? "EAGER" : "DELAYED";
+
+    size_t target_mb = max_target_mb;
+    while (true) {
+        const size_t pool_mb   = target_mb - 8;
+        const size_t pool_size = pool_mb * SIZE_IN_MB;
+        bool mapped = false;
+
+        uint8_t * buf = static_cast<uint8_t *>(
+            rpcmem_alloc2(RPCMEM_HEAP_ID_SYSTEM, RPCMEM_DEFAULT_FLAGS, pool_size));
+        if (!buf) {
+            GGMLHEXAGON_LOG_WARN(
+                "rpc mempool probe: AP allocation %zu MiB failed, trying a smaller pool",
+                pool_mb);
+        } else {
+            ctx->rpc_mempool          = buf;
+            ctx->rpc_mempool_capacity = target_mb * SIZE_IN_MB;
+            ctx->rpc_mempool_len      = pool_size;
+            ctx->rpc_mempool_handle   = rpcmem_to_fd(ctx->rpc_mempool);
+
+            if (ctx->rpc_mempool_handle < 0) {
+                GGMLHEXAGON_LOG_WARN(
+                    "rpc mempool probe: rpcmem_to_fd failed at %zu MiB, trying a smaller pool",
+                    pool_mb);
+            } else {
+                const int mmap_err = fastrpc_mmap(
+                    ctx->domain_id,
+                    ctx->rpc_mempool_handle,
+                    ctx->rpc_mempool,
+                    0,
+                    ctx->rpc_mempool_len,
+                    mmap_flags);
+                if (mmap_err != 0) {
+                    GGMLHEXAGON_LOG_WARN(
+                        "rpc mempool probe: fastrpc_mmap(%s) rejected %zu MiB (error %d), trying a smaller pool",
+                        mmap_mode_str, pool_mb, mmap_err);
+                } else {
+                    mapped = true;
+                    const uint32_t ion_fd  = (uint32_t) ctx->rpc_mempool_handle;
+                    const uint32_t size_lo = (uint32_t) (ctx->rpc_mempool_len & 0xFFFFFFFF);
+                    const uint32_t size_hi = (uint32_t) ((ctx->rpc_mempool_len >> 32) & 0xFFFFFFFF);
+
+                    const int64_t t0_reg = ggml_time_us();
+                    const int reg_err =
+                        ggml_htp_register_rpcmem(ctx->ggmlop_handle, ion_fd, size_lo, size_hi);
+                    const int64_t dt_reg = ggml_time_us() - t0_reg;
+                    if (reg_err == AEE_SUCCESS) {
+                        GGMLHEXAGON_LOG_ALWAYS(
+                            "rpc mempool selected: %zu MiB, fd=%d, map=%s, DSP registration=%lld us",
+                            pool_mb, ctx->rpc_mempool_handle, mmap_mode_str, (long long) dt_reg);
+                        GGMLHEXAGON_LOG_ALWAYS("mempool layout: total=%zuMB", pool_mb);
+
+                        // Prime the RPC overhead profiler only after the pool is
+                        // known to be valid. Failed probes never leak into
+                        // inference state.
+                        for (int i = 0; i < 6; i++) {
+                            (void) hexagon_warmup_invoke_timed(ctx);
+                        }
+                        return 0;
+                    }
+
+                    GGMLHEXAGON_LOG_WARN(
+                        "rpc mempool probe: DSP rejected %zu MiB (0x%x), releasing it and trying smaller",
+                        pool_mb, reg_err);
+                }
+            }
+
+            if (mapped) {
+                fastrpc_munmap(
+                    ctx->domain_id,
+                    ctx->rpc_mempool_handle,
+                    ctx->rpc_mempool,
+                    ctx->rpc_mempool_len);
+            }
+            rpcmem_free(ctx->rpc_mempool);
+            ctx->rpc_mempool          = nullptr;
+            ctx->rpc_mempool_len      = 0;
+            ctx->rpc_mempool_capacity = 0;
+            ctx->rpc_mempool_handle   = -1;
+        }
+
+        if (target_mb <= min_target_mb) {
+            break;
+        }
+        target_mb = target_mb > min_target_mb + step_mb
+            ? target_mb - step_mb
+            : min_target_mb;
+    }
+
+    GGMLHEXAGON_LOG_ERROR(
+        "init rpc mempool: no AP/DSP shared pool from %zu MiB down to %zu MiB could be registered",
+        max_target_mb - 8, min_target_mb - 8);
+    return 6;
+}
 
 static void ggmlhexagon_deinit_rpcmempool(ggml_backend_hexagon_context * ctx) {
     if (ctx->rpc_mempool) {
