+AEEResult ggml_htp_register_rpcmem(remote_handle64 h, uint32_t ion_fd, uint32_t size_lo, uint32_t size_hi) {
+    g_dsp_ctx = (struct dsp_context *)h;
+    if (!g_dsp_ctx) return AEE_EBADPARM;
+    int32_t fd = (int32_t)ion_fd;
+    uint64_t size = ((uint64_t)size_hi << 32) | (uint64_t)size_lo;
+
+    GGMLHEXAGON_LOG_INFO("[MEMPOOL-REG] fd=%d, size=%llu bytes (%dMB)",
+                         fd, (unsigned long long)size, (int32_t)(size >> 20));
+
+    // Match Qualcomm's current dspqueue mapper behavior: one failed HAP_mmap2
+    // can be transient while the PD is settling or reclaiming VA, so retry the
+    // exact same mapping once before asking the AP side to reduce pool size.
+    void * va = (void *)-1;
+    int64_t t0_mmap = ggml_time_us();
+    for (int retry = 0; retry < 2; retry++) {
+#if __HVX_ARCH__ > 73
+        va = HAP_mmap2(NULL, (size_t)size, HAP_PROT_READ | HAP_PROT_WRITE, 0, fd, 0);
+#else
+        va = HAP_mmap(NULL, (size_t)size, HAP_PROT_READ | HAP_PROT_WRITE, 0, fd, 0);
+#endif
+        if (va != NULL && va != (void *)-1) {
+            break;
+        }
+        if (retry == 0) {
+            GGMLHEXAGON_LOG_WARN(
+                "[MEMPOOL-REG] HAP_mmap2 first attempt failed: %p (fd=%d, size=%llu), retrying",
+                va, fd, (unsigned long long)size);
+        }
+    }
+    int64_t dt_mmap = ggml_time_us() - t0_mmap;
+
+    if (va == NULL || va == (void *)-1) {
+        g_dsp_ctx->mempool_dsp_base = NULL;
+        GGMLHEXAGON_LOG_ERROR(
+            "[MEMPOOL-REG] HAP_mmap2 FAILED after retry: returned %p (fd=%d, size=%llu)",
+            va, fd, (unsigned long long)size);
+        return AEE_EFAILED;
+    }
+
+    g_dsp_ctx->mempool_dsp_base = va;
+    g_dsp_ctx->mempool_dsp_size = (size_t)size;
+    // Use FARF(ALWAYS) so the timing log is visible via adb logcat on all builds
+    FARF(ALWAYS, "[MEMPOOL-REG] HAP_mmap2 OK: va=%p (fd=%d, size=%zuMB, time=%lld us)", va, fd, g_dsp_ctx->mempool_dsp_size / (1024*1024), (long long)dt_mmap);
+
+    return AEE_SUCCESS;
+}
 
